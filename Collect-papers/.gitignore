# Downloaded PDFs — large binary files, not for version control
downloads/

# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Runtime data — large, machine-specific, regenerated each run
metadata.jsonl
failed_downloads.jsonl

# Venue cache — keep this tracked (saves API re-resolution for collaborators)
# venue_cache.json  ← intentionally NOT ignored

# Paperbase — generated data files (large / machine-specific)
# title_index.json and duplicate_candidates.json are regenerated by build_index.py
paperbase/title_index.json
paperbase/duplicate_candidates.json
paperbase/confirmed_duplicates.json
paperbase/deletion_log.json
# Validation cache is per-run
downloads/*/validation_cache.json

# OS noise
.DS_Store
Thumbs.db